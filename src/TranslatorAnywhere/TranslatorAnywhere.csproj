<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>TranslatorAnywhere</AssemblyName>
    <AssemblyTitle>Anywhere Translator</AssemblyTitle>
    <Product>Anywhere Translator</Product>
    <RootNamespace>TranslatorAnywhere</RootNamespace>
    <Version>1.2.0</Version>
    <!-- WPF owns PerMonitorV2 awareness; WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Content Include="Assets/TranslationRenderer/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/app.ico" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../RELEASE_NOTES.md" Link="RELEASE_NOTES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Keep the managed assembly identity stable for WPF resource URIs. -->
  <Target Name="RenamePublishedAppHost" AfterTargets="Publish" Condition="'$(UseAppHost)' == 'true'">
    <Move SourceFiles="$(PublishDir)TranslatorAnywhere.exe" DestinationFiles="$(PublishDir)Anywhere Translator.exe" Condition="Exists('$(PublishDir)TranslatorAnywhere.exe')" />
  </Target>
</Project>
