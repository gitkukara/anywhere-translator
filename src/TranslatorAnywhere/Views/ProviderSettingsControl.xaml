<UserControl x:Class="TranslatorAnywhere.Views.ProviderSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TranslatorAnywhere.Views"
             FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" FontSize="13"
             Foreground="{DynamicResource InkBrush}"
             Unloaded="Control_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProviderIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ProviderFieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Left" /><Setter Property="Margin" Value="0,0,12,0" /><Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="ProviderFieldRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,9" /><Setter Property="MinHeight" Value="28" />
            </Style>
            <Style x:Key="ProviderRowButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BackgroundBrush}" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="ListView">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Ui.86ce259375da2a95}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="AddProviderButton" Grid.Column="1" Style="{StaticResource SubtleButton}" Click="AddProvider_Click" AutomationProperties.Name="{DynamicResource Ui.6f760cbd09bb0af5}">
                    <StackPanel Orientation="Horizontal">
                        <views:HugeIcon Kind="Add" Width="16" Height="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False" />
                        <TextBlock Text="{DynamicResource Ui.6f760cbd09bb0af5}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsScrollViewer}">
                <Border x:Name="ProviderListBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="9" VerticalAlignment="Top">
                    <StackPanel x:Name="ProviderListPanel" />
                </Border>
            </ScrollViewer>
            <StackPanel x:Name="EmptyProvidersPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource Ui.70168f89e8ca3802}" Foreground="{DynamicResource MutedBrush}" />
                <Button Content="{DynamicResource Ui.6f760cbd09bb0af5}" Style="{StaticResource SubtleButton}" Click="AddProvider_Click" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
        <Grid x:Name="CatalogView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Button x:Name="CatalogBackButton" Margin="0,0,0,12" Style="{StaticResource ProviderRowButton}" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" Padding="0" MinHeight="32" Click="BackToList_Click" ToolTip="{DynamicResource Ui.101b63b173450aa4}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="20" Height="24" VerticalAlignment="Center"><views:HugeIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" /></Grid>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Ui.c84718167a9792e7}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Button>
            <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsScrollViewer}">
                <Grid VerticalAlignment="Top">
                    <ItemsControl x:Name="CatalogItems" VerticalAlignment="Top" Margin="-4,0,-4,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource ProviderRowButton}" Click="Preset_Click" Tag="{Binding Id}" Margin="4,0,4,8" ToolTip="{Binding Name}">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="14,11" Height="75">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="26" Height="26" />
                                            <views:HugeIcon Kind="Settings" Width="26" Height="26" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <views:HugeIcon.Style><Style TargetType="{x:Type views:HugeIcon}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style></views:HugeIcon.Style>
                                            </views:HugeIcon>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="DetailView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="DetailBackButton" Style="{StaticResource ProviderRowButton}" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" Padding="0" MinHeight="32" Click="DetailBack_Click" ToolTip="{DynamicResource Ui.101b63b173450aa4}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="20" Height="24" VerticalAlignment="Center"><views:HugeIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" /></Grid>
                        <Image x:Name="DetailLogo" Grid.Column="1" Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="DetailTitle" Grid.Column="2" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                </Button>
                <Button x:Name="UseProviderButton" Grid.Column="1" Content="{DynamicResource Ui.a56cc7d468b3442d}" Style="{StaticResource SubtleButton}" Click="UseProvider_Click" Margin="8,0,0,0" />
            </Grid>
            <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsScrollViewer}">
                <Border Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Style="{StaticResource ProviderFieldRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Ui.5df7bfb4b708fa46}" Style="{StaticResource ProviderFieldLabel}" /><TextBox Grid.Column="1" x:Name="ProviderNameBox" Width="250" HorizontalAlignment="Right" TextAlignment="Center" MaxLength="80" TextChanged="Editor_TextChanged" /></Grid>
                        <Grid Style="{StaticResource ProviderFieldRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Ui.d94c3fb876621695}" Style="{StaticResource ProviderFieldLabel}" /><TextBox Grid.Column="1" x:Name="ProviderBaseUrlBox" Width="250" HorizontalAlignment="Right" TextAlignment="Center" TextChanged="Editor_TextChanged" /></Grid>
                        <Grid x:Name="ProtocolRow" Style="{StaticResource ProviderFieldRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Ui.9abcc62354817a76}" Style="{StaticResource ProviderFieldLabel}" /><views:ContentWidthComboBox Grid.Column="1" x:Name="ProtocolBox" HorizontalAlignment="Right" HorizontalContentAlignment="Left" ItemContainerStyle="{StaticResource CompactChoiceComboBoxItem}" SelectionChanged="EditorSelection_Changed"><ComboBoxItem Content="{DynamicResource Ui.20fecb36be4c0a3f}" /><ComboBoxItem Content="Anthropic" /></views:ContentWidthComboBox></Grid>
                        <Grid Style="{StaticResource ProviderFieldRow}" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="API Key" Style="{StaticResource ProviderFieldLabel}" /><PasswordBox Grid.Column="1" x:Name="ProviderApiKeyBox" Width="250" HorizontalAlignment="Right" HorizontalContentAlignment="Center" PasswordChanged="Editor_KeyChanged" ToolTip="{DynamicResource Ui.1f135f50d1ec924f}" /></Grid>
                        <TextBlock x:Name="CredentialHint" Width="250" HorizontalAlignment="Right" Visibility="Collapsed" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <Grid Style="{StaticResource ProviderFieldRow}" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Ui.1b3ae8feb8b283ea}" Style="{StaticResource ProviderFieldLabel}" /><views:ContentWidthComboBox Grid.Column="1" x:Name="SelectedModelCombo" MinWidth="100" MaxWidth="250" HorizontalAlignment="Right" HorizontalContentAlignment="Left" ItemContainerStyle="{StaticResource CompactChoiceComboBoxItem}" IsEditable="True" ToolTip="{DynamicResource Ui.3fdc9dbbd8524839}" SelectionChanged="SelectedModel_SelectionChanged" LostKeyboardFocus="SelectedModel_LostFocus" />
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="ModelListToggleButton" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" MinHeight="28" Padding="0,3" Click="ModelListToggle_Click" AutomationProperties.Name="{Binding Text, ElementName=ModelListToggleLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ModelListToggleLabel" Text="{DynamicResource Ui.9ff8f42237841587}" VerticalAlignment="Center" />
                                    <views:HugeIcon x:Name="ModelListToggleIcon" Kind="ChevronRight" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="6,0,0,0" IsHitTestVisible="False" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RefreshModelsButton" Grid.Column="1" Content="{DynamicResource Ui.a76952e53abfc0d9}" Style="{StaticResource SubtleButton}" Click="RefreshModels_Click" />
                        </Grid>
                        <StackPanel x:Name="ModelListPanel" Width="250" HorizontalAlignment="Right" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBox x:Name="ModelListBox" Height="66" TextAlignment="Center" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="Models_TextChanged" />
                            <TextBlock Text="{DynamicResource Ui.357810b289012e33}" Style="{StaticResource Hint}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Grid x:Name="ProviderThinkingRow" Margin="0,8,0,0" MinHeight="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Ui.12c9eda0f0696205}" VerticalAlignment="Center" />
                            <CheckBox x:Name="ProviderThinkingCheck" Grid.Column="1" Content="" Style="{StaticResource SwitchBar}" AutomationProperties.Name="{DynamicResource Ui.12c9eda0f0696205}" Checked="Editor_Changed" Unchecked="Editor_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,8" Margin="0,8,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <Grid MinHeight="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Ui.2ae27a6bb8ac04d8}" VerticalAlignment="Center" />
                        <CheckBox x:Name="ProviderEnabledCheck" Grid.Column="1" Content="" Style="{StaticResource SwitchBar}" AutomationProperties.Name="{DynamicResource Ui.2ae27a6bb8ac04d8}" Checked="Editor_Changed" Unchecked="Editor_Changed" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="RemoveProviderButton" Content="{DynamicResource Ui.70f2105700a9e686}" Style="{StaticResource SubtleButton}" Foreground="{DynamicResource ErrorBrush}" Click="RemoveProvider_Click" Margin="0,0,6,0" />
                        <Button x:Name="TestConnectionButton" Content="{DynamicResource Ui.0a98a48eaaac4175}" Style="{StaticResource SubtleButton}" Click="TestConnection_Click" />
                        <Button x:Name="CancelConnectionButton" Content="{DynamicResource Ui.ca4d973c0b006b75}" Style="{StaticResource SubtleButton}" Click="CancelConnection_Click" Visibility="Collapsed" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock x:Name="ProviderStatusLabel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource Hint}" Margin="0,10,0,0" MaxHeight="38" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
