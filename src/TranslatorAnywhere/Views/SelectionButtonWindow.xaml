<Window x:Class="TranslatorAnywhere.Views.SelectionButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TranslatorAnywhere.Views"
        Title="划词翻译按钮" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False">
    <Border Padding="8" Background="Transparent">
        <Border x:Name="Tile" Width="32" Height="32" Background="#3390EC" CornerRadius="7" BorderBrush="#24000000" BorderThickness="1"
                Cursor="Hand" MouseLeftButtonUp="OnTranslate" ToolTip="翻译选中文字"
                AutomationProperties.Name="翻译选中文字">
            <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.16" Color="#233646" /></Border.Effect>
            <Grid>
                <TextBlock x:Name="Glyph" Text="翻" Foreground="White" FontSize="20" FontWeight="SemiBold"
                           FontFamily="Microsoft YaHei UI" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <views:HugeIcon x:Name="Symbol" Kind="Translate" Visibility="Collapsed" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="CustomIcon" Visibility="Collapsed" Margin="4" Stretch="Uniform" />
            </Grid>
        </Border>
    </Border>
</Window>
