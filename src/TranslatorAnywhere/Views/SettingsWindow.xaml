<Window x:Class="TranslatorAnywhere.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TranslatorAnywhere.Views"
        Title="划词翻译 · 设置" Width="520" Height="560" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Style="{DynamicResource {x:Type Window}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Left" /><Setter Property="Margin" Value="0,0,12,0" /><Setter Property="TextWrapping" Value="NoWrap" /></Style>
            <Style x:Key="SettingRow" TargetType="Grid"><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="MinHeight" Value="28" /></Style>
            <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16,15,16,14">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TabControl x:Name="SettingsTabs" Background="Transparent" BorderThickness="0" Padding="0,14,0,0">
            <TabItem Header="外观">
                <ScrollViewer x:Name="AppearanceScrollViewer" Style="{StaticResource SettingsScrollViewer}">
                    <StackPanel>
                        <Border x:Name="AppearanceOptionsCard" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="浮动按钮" Style="{StaticResource SectionHeading}" />
                                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="显示方式" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" x:Name="ModeBox" Style="{StaticResource CompactChoiceComboBox}" Width="116" SelectionChanged="Form_Changed"><ComboBoxItem Content="文字" /><ComboBoxItem Content="翻译符号" /><ComboBoxItem Content="自定义图片" /></ComboBox>
                                </Grid>
                                <Grid x:Name="TextModeRow" Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="按钮文字" Style="{StaticResource SettingLabel}" /><TextBox Grid.Column="1" x:Name="ButtonTextBox" Width="116" HorizontalAlignment="Right" TextAlignment="Center" MaxLength="10" TextChanged="Form_Changed" />
                                </Grid>
                                <Grid x:Name="IconModeRow" Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="自定义图标" Style="{StaticResource SettingLabel}" />
                                    <Grid Grid.Column="1" Width="116" HorizontalAlignment="Right"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="IconNameLabel" Text="尚未导入" Style="{StaticResource Hint}" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        <Button Grid.Column="1" Content="导入" Click="ImportIcon_Click" Width="50" Padding="8,4" Margin="6,0,0,0" />
                                    </Grid>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="按钮大小" Style="{StaticResource SettingLabel}" />
                                    <Grid Grid.Column="1" Width="116" HorizontalAlignment="Right"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="6" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="SizeSlider" Minimum="24" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Form_Changed" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" x:Name="SizeLabel" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="按钮颜色" Style="{StaticResource SettingLabel}" /><TextBox Grid.Column="1" x:Name="ColorBox" Width="116" HorizontalAlignment="Right" TextAlignment="Center" TextChanged="Form_Changed" ToolTip="颜色格式：#RRGGBB，例如 #3390EC" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="透明度" Style="{StaticResource SettingLabel}" />
                                    <Grid Grid.Column="1" Width="116" HorizontalAlignment="Right"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="6" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="TransparencySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Form_Changed" VerticalAlignment="Center" ToolTip="0% 不透明，100% 完全透明" />
                                        <TextBlock Grid.Column="2" x:Name="TransparencyLabel" Text="0%" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,5,0,12" />
                                <TextBlock Text="出现位置" Style="{StaticResource SectionHeading}" />
                                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="相对选区" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" x:Name="AnchorBox" Style="{StaticResource CompactChoiceComboBox}" Width="116" SelectionChanged="Form_Changed"><ComboBoxItem Content="右上角" /><ComboBoxItem Content="右下角" /><ComboBoxItem Content="左上角" /><ComboBoxItem Content="左下角" /><ComboBoxItem Content="鼠标附近" /></ComboBox>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="横／纵偏移（px）" Style="{StaticResource SettingLabel}" />
                                    <Grid Grid.Column="1" Width="116" HorizontalAlignment="Right"><Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="16" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="OffsetXBox" TextAlignment="Center" TextChanged="Form_Changed" ToolTip="横向偏移（px），正数向右。" />
                                        <TextBlock Grid.Column="1" Text="／" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /><TextBox Grid.Column="2" x:Name="OffsetYBox" TextAlignment="Center" TextChanged="Form_Changed" ToolTip="纵向偏移（px），正数向下。" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    <Border x:Name="AppearancePreviewCard" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="预览" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="选择下方文字，查看按钮位置。" />
                                <Button Grid.Column="1" x:Name="TestSelectionButton" Content="测试取词" Style="{StaticResource SubtleButton}" FontSize="12" Padding="7,3" MinHeight="26" Click="TestSelection_Click" ToolTip="打开可选择的测试文本" />
                            </Grid>
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="7" ClipToBounds="True">
                                <Canvas x:Name="PreviewCanvas" Height="148" SizeChanged="PreviewCanvas_SizeChanged" MouseMove="PreviewCanvas_MouseMove" ToolTip="{Binding Text, ElementName=PreviewPositionLabel}">
                                    <TextBox x:Name="PreviewText" Canvas.Left="16" Canvas.Top="22" Width="200" Height="Auto" MinHeight="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled"
                                             SelectionChanged="PreviewText_SelectionChanged" IsInactiveSelectionHighlightEnabled="True" Text="Reading opens a window to the world.&#x0a;&#x0a;试着选择这里的文字。" />
                                    <Border x:Name="PreviewSelectionOutline" BorderBrush="#79B7F2" BorderThickness="1" CornerRadius="2" IsHitTestVisible="False" Visibility="Collapsed" />
                                    <Border x:Name="PreviewButton" Background="{StaticResource AccentBrush}" Width="32" Height="32" CornerRadius="7" BorderBrush="#24000000" BorderThickness="1" IsHitTestVisible="False"><ContentControl x:Name="PreviewButtonContent" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                </Canvas>
                            </Border>
                            <TextBlock x:Name="PreviewPositionLabel" Style="{StaticResource Hint}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="翻译服务">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="翻译为" Style="{StaticResource SettingLabel}" />
                            <ComboBox Grid.Column="1" x:Name="LanguageBox" Style="{StaticResource CompactChoiceComboBox}" Width="116" IsEditable="False" SelectedValuePath="Content" ToolTip="点击翻译后，原文会发送至当前服务。"><ComboBoxItem Content="简体中文" /><ComboBoxItem Content="繁体中文" /><ComboBoxItem Content="English" /><ComboBoxItem Content="日本語" /><ComboBoxItem Content="한국어" /></ComboBox>
                        </Grid>
                    </Border>
                    <views:ProviderSettingsControl x:Name="ProviderEditor" Grid.Row="1" />
                </Grid>
            </TabItem>
            <TabItem Header="其他设置">
                <ScrollViewer x:Name="OtherScrollViewer" Style="{StaticResource SettingsScrollViewer}">
                    <Border Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="启用全局划词翻译" VerticalAlignment="Center" />
                                <CheckBox x:Name="EnabledBox" Grid.Column="1" Content="" Style="{StaticResource SwitchBar}" AutomationProperties.Name="启用全局划词翻译" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,10,0,10" />
                            <Grid Style="{StaticResource SettingRow}" Margin="0" ToolTip="登录 Windows 后自动运行，仅显示托盘图标。"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="开机静默启动" VerticalAlignment="Center" />
                                <CheckBox x:Name="LaunchAtStartupCheck" Grid.Column="1" Content="" Style="{StaticResource SwitchBar}" AutomationProperties.Name="开机静默启动" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12" />
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="确认延迟（ms）" Style="{StaticResource SettingLabel}" /><TextBox Grid.Column="1" x:Name="DelayBox" Width="64" HorizontalAlignment="Right" TextAlignment="Center" ToolTip="选区确认延迟，单位为毫秒" /></Grid>
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="自动隐藏（s）" Style="{StaticResource SettingLabel}" /><TextBox Grid.Column="1" x:Name="AutoHideBox" Width="64" HorizontalAlignment="Right" TextAlignment="Center" ToolTip="按钮自动隐藏时间，单位为秒" /></Grid>
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="排除应用" Style="{StaticResource SettingLabel}" /><TextBox Grid.Column="1" x:Name="ExcludedAppsBox" Width="240" HorizontalAlignment="Right" TextAlignment="Center" AcceptsReturn="True" Height="48" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="填写进程名，用逗号或换行分隔。例如：notepad.exe。" /></Grid>
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12" />
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="快捷键取词失败时，尝试复制取词" VerticalAlignment="Center" />
                                <CheckBox x:Name="HotkeyFallbackBox" Grid.Column="1" Content="" Style="{StaticResource SwitchBar}" AutomationProperties.Name="快捷键取词失败时，尝试复制取词" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}" ToolTip="仅在下方兼容名单中的应用启用。"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="兼容应用自动复制取词" VerticalAlignment="Center" />
                                <CheckBox x:Name="AutomaticFallbackBox" Grid.Column="1" Content="" Style="{StaticResource SwitchBar}" Checked="AutomaticFallback_Changed" Unchecked="AutomaticFallback_Changed" AutomationProperties.Name="兼容应用自动复制取词" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="兼容名单" Style="{StaticResource SettingLabel}" /><TextBox Grid.Column="1" x:Name="FallbackAppsBox" Width="240" HorizontalAlignment="Right" TextAlignment="Center" AcceptsReturn="True" Height="48" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="每行一个进程名。终端程序不会自动复制取词。" /></Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="1" x:Name="StatusLabel" Visibility="Collapsed" Style="{StaticResource Hint}" Foreground="{StaticResource ErrorBrush}" Margin="0,8,0,0" MaxHeight="38" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
