<Window x:Class="TranslatorAnywhere.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TranslatorAnywhere.Views"
        Title="Anywhere Translator" Width="520" Height="560" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterScreen" Style="{DynamicResource {x:Type Window}}">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="ColorPreset" TargetType="Button">
                <Setter Property="Width" Value="24" /><Setter Property="Height" Value="28" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Grid Background="Transparent"><Border x:Name="Swatch" Width="18" Height="18" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="#18000000" BorderThickness="1" /></Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.8" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.6" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SettingLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Left" /><Setter Property="Margin" Value="0,0,12,0" /><Setter Property="TextWrapping" Value="NoWrap" /></Style>
            <Style x:Key="SettingRow" TargetType="Grid"><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="MinHeight" Value="28" /></Style>
            <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16,15,16,14">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TabControl x:Name="SettingsTabs" Background="Transparent" BorderThickness="0" Padding="0,14,0,0">
            <TabItem Header="外观">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer x:Name="AppearanceScrollViewer" Style="{StaticResource SettingsScrollViewer}">
                    <StackPanel>
                        <Border x:Name="AppearanceOptionsCard" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                            <StackPanel>
                            <Grid Style="{StaticResource SettingRow}" Margin="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="界面主题" Style="{StaticResource SettingLabel}" />
                                <ListBox x:Name="ThemeBox" Grid.Column="1" Style="{StaticResource SegmentedChoice}" AutomationProperties.Name="界面主题">
                                    <ListBoxItem Content="跟随系统" /><ListBoxItem Content="浅色" /><ListBoxItem Content="深色" />
                                </ListBox>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,12" />
                                <TextBlock Text="浮动按钮" Style="{StaticResource SectionHeading}" />
                                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="显示方式" Style="{StaticResource SettingLabel}" />
                                    <ListBox Grid.Column="1" x:Name="ModeBox" Style="{StaticResource SegmentedChoice}" AutomationProperties.Name="显示方式" SelectionChanged="Form_SelectionChanged"><ListBoxItem Content="文字" /><ListBoxItem Content="符号" /><ListBoxItem Content="自设" /></ListBox>
                                </Grid>
                                <Grid x:Name="TextModeRow" Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="按钮文字" Style="{StaticResource SettingLabel}" /><TextBox Grid.Column="1" x:Name="ButtonTextBox" Width="116" HorizontalAlignment="Right" TextAlignment="Center" MaxLength="10" TextChanged="Form_Changed" />
                                </Grid>
                                <Grid x:Name="IconModeRow" Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="自定义图标" Style="{StaticResource SettingLabel}" />
                                    <Grid Grid.Column="1" Width="116" HorizontalAlignment="Right"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="IconNameLabel" Text="尚未导入" Style="{StaticResource Hint}" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        <Button Grid.Column="1" Content="导入" Click="ImportIcon_Click" Width="50" Padding="8,4" Margin="6,0,0,0" />
                                    </Grid>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="按钮大小" Style="{StaticResource SettingLabel}" />
                                    <ListBox Grid.Column="1" x:Name="SizeChoice" Style="{StaticResource SegmentedChoice}" AutomationProperties.Name="按钮大小" SelectionChanged="Form_SelectionChanged"><ListBoxItem Content="较小" Tag="24" /><ListBoxItem Content="标准" Tag="32" /><ListBoxItem Content="较大" Tag="40" /><ListBoxItem Content="最大" Tag="48" /></ListBox>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="按钮颜色" Style="{StaticResource SettingLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="BluePreset" Style="{StaticResource ColorPreset}" Background="#3390EC" Tag="#3390EC" ToolTip="#3390EC" AutomationProperties.Name="使用颜色 #3390EC" Click="ColorPreset_Click" />
                                        <Button x:Name="CyanPreset" Style="{StaticResource ColorPreset}" Background="#63BBD0" Tag="#63BBD0" ToolTip="#63BBD0" AutomationProperties.Name="使用颜色 #63BBD0" Click="ColorPreset_Click" />
                                        <Button x:Name="PurplePreset" Style="{StaticResource ColorPreset}" Background="#61649F" Tag="#61649F" ToolTip="#61649F" AutomationProperties.Name="使用颜色 #61649F" Click="ColorPreset_Click" />
                                        <Border Width="1" Height="16" Background="{DynamicResource DividerBrush}" Margin="6,0,8,0" VerticalAlignment="Center" />
                                        <Border x:Name="CurrentColorSwatch" Width="18" Height="18" CornerRadius="4" Background="#3390EC" BorderBrush="#18000000" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="当前颜色" AutomationProperties.Name="当前颜色" />
                                        <TextBox x:Name="ColorBox" Width="84" Padding="6,4" TextAlignment="Center" TextChanged="Form_Changed" ToolTip="颜色格式：#RRGGBB，例如 #3390EC" />
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="透明度" Style="{StaticResource SettingLabel}" />
                                    <ListBox Grid.Column="1" x:Name="TransparencyChoice" Style="{StaticResource SegmentedChoice}" AutomationProperties.Name="透明度" SelectionChanged="Form_SelectionChanged"><ListBoxItem Content="25%" Tag="25" /><ListBoxItem Content="50%" Tag="50" /><ListBoxItem Content="75%" Tag="75" /><ListBoxItem Content="100%" Tag="100" /></ListBox>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,5,0,12" />
                                <TextBlock Text="出现位置" Style="{StaticResource SectionHeading}" />
                                <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="相对选区" Style="{StaticResource SettingLabel}" />
                                    <ListBox Grid.Column="1" x:Name="AnchorBox" Style="{StaticResource SegmentedChoice}" SelectedValuePath="Tag" AutomationProperties.Name="相对选区" SelectionChanged="Form_SelectionChanged"><ListBoxItem Content="左上" Tag="SelectionTopLeft" /><ListBoxItem Content="左下" Tag="SelectionBottomLeft" /><ListBoxItem Content="右上" Tag="SelectionTopRight" /><ListBoxItem Content="右下" Tag="SelectionBottomRight" /></ListBox>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="横／纵偏移（px）" Style="{StaticResource SettingLabel}" />
                                    <Grid Grid.Column="1" Width="96" HorizontalAlignment="Right"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="16" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="OffsetXBox" Padding="5,4" TextAlignment="Center" TextChanged="Form_Changed" ToolTip="横向偏移（px），正数向右。" />
                                        <TextBlock Grid.Column="1" Text="／" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /><TextBox Grid.Column="2" x:Name="OffsetYBox" Padding="5,4" TextAlignment="Center" TextChanged="Form_Changed" ToolTip="纵向偏移（px），正数向下。" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                    <Button Grid.Row="1" x:Name="TestSelectionButton" Content="点这里预览测试" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right" Margin="0,8,0,0" FontSize="12" Padding="9,5" MinHeight="28" Click="TestSelection_Click" ToolTip="打开测试文本，选择文字查看实际按钮样式和位置" />
                </Grid>
            </TabItem>
            <TabItem Header="翻译服务">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="翻译为" Style="{StaticResource SettingLabel}" />
                            <views:ContentWidthComboBox Grid.Column="1" x:Name="LanguageBox" Style="{StaticResource CompactChoiceComboBox}" IsEditable="False" SelectedValuePath="Content" ToolTip="点击翻译后，原文会发送至当前服务。"><ComboBoxItem Content="简体中文" /><ComboBoxItem Content="繁体中文" /><ComboBoxItem Content="English" /><ComboBoxItem Content="日本語" /><ComboBoxItem Content="한국어" /></views:ContentWidthComboBox>
                        </Grid>
                    </Border>
                    <views:ProviderSettingsControl x:Name="ProviderEditor" Grid.Row="1" />
                </Grid>
            </TabItem>
            <TabItem Header="其他设置">
                <ScrollViewer x:Name="OtherScrollViewer" Style="{StaticResource SettingsScrollViewer}">
                    <Border Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="启用全局划词翻译" VerticalAlignment="Center" />
                                <CheckBox x:Name="EnabledBox" Grid.Column="1" Content="" Style="{StaticResource SwitchBar}" AutomationProperties.Name="启用全局划词翻译" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,10" />
                            <Grid Style="{StaticResource SettingRow}" Margin="0" ToolTip="登录 Windows 后自动运行，仅显示托盘图标。"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="开机静默启动" VerticalAlignment="Center" />
                                <CheckBox x:Name="LaunchAtStartupCheck" Grid.Column="1" Content="" Style="{StaticResource SwitchBar}" AutomationProperties.Name="开机静默启动" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,12" />
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="确认延迟（ms）" Style="{StaticResource SettingLabel}" /><TextBox Grid.Column="1" x:Name="DelayBox" Width="64" HorizontalAlignment="Right" TextAlignment="Center" ToolTip="选区确认延迟，单位为毫秒" /></Grid>
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="自动隐藏（s）" Style="{StaticResource SettingLabel}" /><TextBox Grid.Column="1" x:Name="AutoHideBox" Width="64" HorizontalAlignment="Right" TextAlignment="Center" ToolTip="按钮自动隐藏时间，单位为秒" /></Grid>
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="排除应用" Style="{StaticResource SettingLabel}" /><TextBox Grid.Column="1" x:Name="ExcludedAppsBox" Width="240" HorizontalAlignment="Right" TextAlignment="Center" AcceptsReturn="True" Height="48" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="填写进程名，用逗号或换行分隔。例如：notepad.exe。" /></Grid>
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,12" />
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="快捷键取词失败时，尝试复制取词" VerticalAlignment="Center" />
                                <CheckBox x:Name="HotkeyFallbackBox" Grid.Column="1" Content="" Style="{StaticResource SwitchBar}" AutomationProperties.Name="快捷键取词失败时，尝试复制取词" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}" ToolTip="仅在下方兼容名单中的应用启用。"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="兼容应用自动复制取词" VerticalAlignment="Center" />
                                <CheckBox x:Name="AutomaticFallbackBox" Grid.Column="1" Content="" Style="{StaticResource SwitchBar}" Checked="AutomaticFallback_Changed" Unchecked="AutomaticFallback_Changed" AutomationProperties.Name="兼容应用自动复制取词" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="兼容名单" Style="{StaticResource SettingLabel}" /><TextBox Grid.Column="1" x:Name="FallbackAppsBox" Width="240" HorizontalAlignment="Right" TextAlignment="Center" AcceptsReturn="True" Height="48" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="每行一个进程名。终端程序不会自动复制取词。" /></Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="1" x:Name="StatusLabel" Visibility="Collapsed" Style="{StaticResource Hint}" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0" MaxHeight="38" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
