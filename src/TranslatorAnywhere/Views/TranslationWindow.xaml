<Window x:Class="TranslatorAnywhere.Views.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TranslatorAnywhere.Views"
        Title="{DynamicResource Ui.3b02edcd404ddddc}" Width="400" SizeToContent="Height" MinHeight="168"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="Manual"
        Closing="Window_Closing" IsVisibleChanged="Window_IsVisibleChanged" PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged" Style="{DynamicResource {x:Type Window}}">
    <Border Padding="10" Background="Transparent">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10">
            <Border.Effect><DropShadowEffect Color="#233646" BlurRadius="16" ShadowDepth="3" Opacity="0.14" /></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" /><RowDefinition Height="2" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="14,0,7,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <views:HugeIcon Kind="Translate" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                        <TextBlock x:Name="LanguageLabel" Text="{DynamicResource Ui.9937e365aaf3a085}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ToggleButton x:Name="PinnedBox" Grid.Column="1" Width="28" Height="28" Margin="0,0,2,0"
                                  ToolTip="{DynamicResource Ui.32741f46b35d9ab3}" AutomationProperties.Name="{DynamicResource Ui.245d75833069e7f0}" Checked="Pinned_Changed" Unchecked="Pinned_Changed" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="PinChrome" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent">
                                <views:HugeIcon x:Name="PinIcon" Kind="Pin" Width="18" Height="18" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PinChrome" Property="Background" Value="{DynamicResource BackgroundBrush}" /></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="PinChrome" Property="Background" Value="{DynamicResource AccentLightBrush}" /><Setter TargetName="PinIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="{DynamicResource Ui.df3d58c7d84b85f2}" AutomationProperties.Name="{DynamicResource Ui.df3d58c7d84b85f2}">
                        <views:HugeIcon Kind="Settings" Width="18" Height="18" Foreground="{DynamicResource MutedBrush}" />
                    </Button>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                <ProgressBar x:Name="RequestProgress" Grid.Row="1" IsIndeterminate="True" Height="2" BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}" Background="Transparent" Visibility="Collapsed" />
                <Grid Grid.Row="2" Margin="16,14,16,12" MinHeight="52">
                    <views:TranslationResultView x:Name="ResultTextBox"
                             MaxHeight="360" BorderThickness="0" Padding="0" Background="Transparent" FontSize="15"
                             Foreground="{DynamicResource InkBrush}"
                             FontFamily="Microsoft YaHei UI, Segoe UI" TextBlock.LineHeight="24" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                             AutomationProperties.Name="{DynamicResource Ui.80461c2decc549dc}" />
                    <StackPanel x:Name="EmptyResultPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8">
                        <TextBlock x:Name="EmptyResultLabel" Text="{DynamicResource Ui.ce77b9bb406e7fa4}" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                        <Button x:Name="ConfigureButton" Content="{DynamicResource Ui.cb1ec474f33b90bd}" Style="{StaticResource SubtleButton}" Click="Settings_Click" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ErrorDetailLabel" Grid.Row="3" Visibility="Collapsed" Margin="16,0,16,10" FontSize="12" LineHeight="18"
                           Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" MaxHeight="90" TextTrimming="CharacterEllipsis" />
                <Border Grid.Row="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,3,8,3">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="RequestStatusLabel" Text="{DynamicResource Ui.ce77b9bb406e7fa4}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource IconButton}" Click="Cancel_Click" Visibility="Collapsed" ToolTip="{DynamicResource Ui.e26aeac640fedafd}" AutomationProperties.Name="{DynamicResource Ui.e26aeac640fedafd}">
                            <views:HugeIcon Kind="Stop" Width="18" Height="18" Foreground="{DynamicResource MutedBrush}" />
                        </Button>
                        <Button x:Name="RetryButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="Retry_Click" ToolTip="{DynamicResource Ui.496b5f088e5b9bbf}" AutomationProperties.Name="{DynamicResource Ui.496b5f088e5b9bbf}" Margin="0,0,3,0">
                            <views:HugeIcon Kind="Refresh" Width="18" Height="18" Foreground="{DynamicResource MutedBrush}" />
                        </Button>
                        <Button x:Name="CopyButton" Grid.Column="3" Style="{StaticResource IconButton}" Click="Copy_Click" IsEnabled="False" ToolTip="{DynamicResource Ui.032eb48c7a431ec0}" AutomationProperties.Name="{DynamicResource Ui.032eb48c7a431ec0}">
                            <Grid Width="18" Height="18">
                                <views:HugeIcon x:Name="CopyIcon" Kind="Copy" Width="18" Height="18" Foreground="{DynamicResource MutedBrush}" />
                                <views:HugeIcon x:Name="CopySuccessIcon" Kind="Check" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
